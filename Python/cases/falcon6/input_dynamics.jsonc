/* FALCON6, 6-DOF flat earth. One vehicle: PLANE6 (F-16).
   Open-loop dynamics, with guidance left open. */
{
  "title": "input_dynamics.asc open loop dynamics",
  "options": {
    "scrn": true,
    "events": false,
    "tabout": false,
    "plot": true,
    "merge": false,
    "doc": true,
    "comscrn": false,
